POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-password
POSTGRES_PORT=54329
POSTGRES_BIND_ADDRESS=127.0.0.1
AGENTIC_DATA_IMAGE=ghcr.io/jason-doyle/agentic-data-kernel:0.2.0-alpha.1
DATABASE_URL=postgresql://agentic_app:replace-with-a-different-long-random-password@127.0.0.1:54329/agentic_data
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@127.0.0.1:54329/agentic_data

# At least 32 random characters. Used only to hash high-entropy API tokens.
AUTH_PEPPER=replace-with-at-least-32-random-characters

# Generate values with: .\scripts\generate-secrets.ps1
ARTIFACT_CURRENT_KEY_ID=v1
ARTIFACT_KEYRING={"v1":"replace-with-a-base64-encoded-32-byte-key"}
ARTIFACT_DIR=.data/production-artifacts
ARTIFACT_DIR_HOST=./.data/production-artifacts

# Any OpenAI-compatible embeddings endpoint returning 1536-dimensional vectors.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-provider-key
EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated HTTPS hosts that effect workers may contact.
EFFECT_ALLOWED_HOSTS=payments.example.com
EFFECT_MAX_ATTEMPTS=10

HOST=127.0.0.1
PORT=4318
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
SERVER_NAME=localhost
LOG_LEVEL=info
